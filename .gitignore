# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Build artifacts
*.apk
android/app/build/
android/.gradle/
android/build/
__pycache__/
*.pyc

# Signing
*.keystore
*.jks

# Temp/build helper files
android-app/_*.txt
android-app/_*.js
android-app/preview.html
android-app/icon-generator.html
android-app/preview-logos/


# Local agent artifacts
%APPDATA%/
.freebuff/
flux-kontext-max*.jpg

# Local agent runtime state (skills cache, MCP config, fingerprints).
# The .agents/memory/ docs ARE tracked.
.agents/.fingerprint/
.agents/skills/
.agents/mcp.json

# Secrets / environment — never commit Figma tokens, Stripe keys, etc.
.env
.env.local
.env.*.local

# One-off planning docs and design exports (not part of the build).
DESIGN_RECOMMENDATION.md
STITCH_BRIEF.md
designs/

# dev-helper scripts that ran once during initial app setup; the
# remaining tools/make_license.py IS tracked (license keygen).
tools/*.mjs
tools/install_official_icon.py
tools/make_launcher_pngs.py

# ad-hoc debug / audit scripts.
audit_node.js
dump*.xml
android-app/dump*.xml

# Figma + manual QA screenshots / dumps / specs (not part of build).
# Note: artifacts/social-downloader/ is the old Capacitor web wrapper
# and IS tracked — only the loose artifacts/ top-level files are ignored.
artifacts/*.png
artifacts/*.txt
artifacts/figma/
