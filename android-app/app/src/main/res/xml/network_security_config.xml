<?xml version="1.0" encoding="utf-8"?>
<!--
    Play Store hardening: block all cleartext (http://) traffic by default.
    Every production endpoint the app talks to (platform sites, AdMob,
    Play Billing / Integrity, notices JSON) is HTTPS-only.

    Exception kept for local development only: the optional on-device /
    LAN entitlement server (PremiumConfig.ENFORCEMENT_BASE_URL) may run as
    plain http on loopback / RFC1918 during testing. Release builds should
    point it at an https:// URL — the exception below never weakens traffic
    to public hosts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local dev server. Untuk testing billing Midtrans via api-server lokal,
         tambahkan IP Wi-Fi laptop kamu (lihat ipconfig / ifconfig). Contoh:
         <domain>192.168.1.10</domain>. Release build WAJIB pakai HTTPS
         publik — jangan cleartext ke server non-lokal. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">192.168.1.10</domain>
    </domain-config>
</network-security-config>
