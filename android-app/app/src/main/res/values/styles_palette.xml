<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Implicit parent for dotted palette style names. -->
    <style name="Palette" />

    <!-- TubeNime curated palettes. Sakura is the default: values/colors.xml +
         values-night/colors.xml already hold its values, so its style is empty
         and ThemeEngine only applies a style when a non-default palette is chosen. -->

    <!-- Mochi Mint — matcha & red bean -->
    <style name="Palette.Mochi">
        <item name="colorPrimary">@color/primary_mochi</item>
        <item name="colorPrimaryDark">@color/primary_dark_mochi</item>
        <item name="colorPrimaryVariant">@color/primary_light_mochi</item>
        <item name="colorSecondary">@color/accent_mochi</item>
        <item name="colorSecondaryVariant">@color/accent_light_mochi</item>
        <item name="android:statusBarColor">@color/primary_mochi</item>
        <item name="PalettePrimary">@color/primary_mochi</item>
        <item name="PalettePrimaryDark">@color/primary_dark_mochi</item>
        <item name="PalettePrimaryLight">@color/primary_light_mochi</item>
        <item name="PaletteAccent">@color/accent_mochi</item>
        <item name="PaletteAccentLight">@color/accent_light_mochi</item>
        <item name="PaletteAnimePink">@color/anime_pink_mochi</item>
        <item name="PaletteAnimePurple">@color/anime_purple_mochi</item>
        <item name="PaletteGradientStart">@color/anime_gradient_start_mochi</item>
        <item name="PaletteGradientEnd">@color/anime_gradient_end_mochi</item>
        <item name="PaletteCardAnimeBg">@color/card_anime_bg_mochi</item>
        <item name="PaletteCardQuickBg">@color/card_quick_bg_mochi</item>
        <item name="PaletteSurface">@color/surface_mochi</item>
        <item name="PaletteSurfaceVariant">@color/surface_variant_mochi</item>
        <item name="PaletteBackground">@color/background_mochi</item>
        <item name="PaletteDivider">@color/divider_mochi</item>
        <item name="PaletteNoticeBg">@color/notice_bg_mochi</item>
    </style>

