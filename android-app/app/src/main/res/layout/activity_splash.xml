<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/splash_background">

    <!-- Slot logo: AVD goresan tinta (phase 1) crossfade ke logo resmi (phase 2) -->
    <FrameLayout
        android:id="@+id/splashLogoSlot"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginBottom="24dp">

        <!-- Logo resmi (tile putih membulat) — muncul di phase 2 -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/brand_logo"
            android:contentDescription="@string/app_name"
            android:visibility="invisible" />

        <!-- Avatar goresan tinta (phase 1) — AVD speed-arcs menelusuri dirinya -->
        <ImageView
            android:id="@+id/splashInkAvatar"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:src="@drawable/splash_ink_avatar"
            android:contentDescription="@string/app_name" />
    </FrameLayout>

    <!-- App Name -->
    <TextView
        android:id="@+id/splashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="@font/baloo2_extrabold"
        android:layout_marginBottom="8dp" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/splashSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎌 Download videos from YouTube, TikTok, Instagram &amp; more"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:paddingHorizontal="32dp" />

    <!-- Loading indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:indicatorSize="24dp"
        app:trackThickness="2dp"
        app:trackColor="#80FFFFFF" />

</LinearLayout>
