<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- URL Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/primary">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                app:tint="@color/white" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Search or enter URL"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                app:boxCornerRadiusTopStart="22dp"
                app:boxCornerRadiusTopEnd="22dp"
                app:boxCornerRadiusBottomStart="22dp"
                app:boxCornerRadiusBottomEnd="22dp"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/primary"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_secondary"
                app:endIconMode="clear_text"
                android:layout_gravity="center_vertical">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Refresh/Go button -->
            <ImageButton
                android:id="@+id/goButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go/Refresh"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <!-- Main Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- WebView -->
            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Homepage Grid (shown when no URL loaded) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/homepageGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <!-- App Logo/Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="48sp"
                        android:layout_marginTop="24dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse &amp; Download"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visit any site, play a video, and download it"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Quick Access Platforms -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Access"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Row 1: YouTube, TikTok -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/siteYoutube"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#FFEBEE">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:gravity="center">
                                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_youtube" android:contentDescription="YouTube" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YouTube" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/youtube_red" android:layout_marginTop="6dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/siteTiktok"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#FCE4EC">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:gravity="center">
                                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_tiktok_logo" android:contentDescription="TikTok" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TikTok" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/tiktok_pink" android:layout_marginTop="6dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Row 2: Instagram, Facebook -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/siteInstagram"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#F3E5F5">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:gravity="center">
                                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_instagram_logo" android:contentDescription="Instagram" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Instagram" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/instagram_pink" android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/siteFacebook"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#E3F2FD">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:gravity="center">
                                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_facebook_logo" android:contentDescription="Facebook" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Facebook" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/facebook_blue" android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/siteThreads"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#E0E0E0">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:gravity="center">
                                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_threads_logo" android:contentDescription="Threads" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Threads" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Paste URL shortcut -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pasteButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="📋 Paste URL from Clipboard"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        style="@style/Widget.VidGrab.Button.Outlined"
                        app:strokeColor="@color/primary"
                        app:icon="@drawable/ic_paste"
                        app:iconTint="@color/primary" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Floating Download Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:visibility="gone"
                android:elevation="8dp"
                app:backgroundTint="@color/accent"
                app:srcCompat="@drawable/ic_download"
                app:tint="@color/white" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
